# Public site origin used for Checkout return URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Do not prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. This app does not send the anon key to the browser.
# Use it in the Supabase dashboard or SQL editor when you want to confirm
# that the public Data API cannot read registrations.
SUPABASE_ANON_KEY=

# Optional. If SUPABASE_URL is unset, the server uses this Postgres URL instead.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bench_and_trade

# Stripe test mode only. Prefer a restricted key (rk_test_). sk_test_ is accepted.
# A live key is refused. Checkout Sessions: write and read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Not required. Checkout is a hosted redirect, so the page does not load Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin list at /admin. Use a long random string for the session secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
