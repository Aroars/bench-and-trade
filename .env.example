# Public site origin used for Checkout return URLs and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Do not prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. This app does not send the anon key to the browser.
# Use it in the Supabase dashboard or SQL editor when you want to confirm
# that the public Data API cannot read registrations.
SUPABASE_ANON_KEY=

# Optional. If SUPABASE_URL is unset, the server uses this Postgres URL instead.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bench_and_trade

# Stripe test mode only. Prefer a restricted key (rk_test_). sk_test_ is accepted.
# A live key is refused. Checkout Sessions: write and read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Not required. Checkout is a hosted redirect, so the page does not load Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Admin list at /admin. Use a long random string for the session secret.
# The session secret also signs waitlist unsubscribe links unless
# EMAIL_UNSUBSCRIBE_SECRET is set.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Email through Resend. See docs/email.md.
# Leave RESEND_API_KEY empty and nothing is sent; each send is logged as skipped.
RESEND_API_KEY=
# Optional. Defaults to "Bench & Trade <classes@send.benchandtrade.com>".
EMAIL_FROM=
# Optional. Omitted from the message when empty.
EMAIL_REPLY_TO=
# Optional. Signs unsubscribe links instead of ADMIN_SESSION_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=

# Vercel sends this as "Authorization: Bearer ..." when it runs /api/cron/reminders.
# Vercel sets it for you when the cron is created. Set it by hand for local runs.
CRON_SECRET=
